{
  "name": "dsh-personal-directive",
  "version": "0.2.0",
  "description": "Repository prompt plugin with a live top-bar enable/disable switch (framework edition: ships a neutral placeholder directive).",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "directive",
    "cordis"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "prompts",
    "README.md"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check lib/client.js",
    "test": "node --test test/index.test.mjs",
    "check": "node --check index.js && node --check lib/client.js && node --check test/index.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-gateway": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.1-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  }
}
